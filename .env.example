# Name shown in the app and on the invite QR code
APP_NAME=Billard

# Anyone with this key (via QR code) can create an account. Generate one with: openssl rand -hex 16
INVITE_KEY=change-me

# Comma-separated user numbers with admin rights. The first account created gets number 1.
ADMIN_USER_IDS=1

# Public address, used to build the invite link (optional, defaults to the request origin)
PUBLIC_URL=https://billard.example.com

# Set to true when the app is served over HTTPS
COOKIE_SECURE=true

PORT=3000
DATABASE_PATH=./data/billard.sqlite

# Push messages. Keys are generated automatically if left empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
